# Copy to .env before running Docker Compose; fill the four required values.
OJ_USERNAME=
OJ_PASSWORD=
AI_API_KEY=
WEBUI_AUTH_TOKEN=

# Host port; bound to localhost only.
WEBUI_PORT=5000

# Optional per-provider keys (only needed when referenced by models).
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=

# Optional override; omit to manage the start page in JSON / Web UI.
# OJ_CONTEST_START_PAGE=2
