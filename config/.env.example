# OJ AI 解题系统 — 环境变量配置
# 复制为 config/.env 并填入实际值

# ── OJ 站点 ──
OJ_ROOT=https://oj.yuanyicode.com
OJ_BASE=https://oj.yuanyicode.com/d/system
OJ_USERNAME=your_username
OJ_PASSWORD=your_password

# ── AI API ──
AI_API_KEY=sk-xxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro

# ── 每模型独立 API Key ──
DEEPSEEK_API_KEY=sk-xxx
ZHIPU_API_KEY=your_zhipu_key

# ── WebUI 登录 ──
# 密码必填；留空时 webui.py 拒绝启动。用户名默认 admin。
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change-me
# 可选：固定会话签名密钥；不设置则每次重启后需重新登录。
# WEBUI_SECRET_KEY=
# 可选：HTTPS 反向代理时启用 Secure Cookie。
# WEBUI_COOKIE_SECURE=1

# ── 可选配置 ──
# AI_MAX_TOKENS=384000
# AI_REASONING_EFFORT=high
# OJ_LANG=cc.cc14o2

# 推荐先运行 python config_cli.py init 创建单模型配置。
# config/.env 只需填写 OJ_USERNAME、OJ_PASSWORD、AI_API_KEY；其余设置可留在 config/config.json。
# 模型级密钥引用推荐写成 env:DEEPSEEK_API_KEY，缺失时不会回退其他服务的密钥。

# 比赛列表起始页，默认2；设为1可包含首页
# OJ_CONTEST_START_PAGE=2
# Docker 部署请使用 config/.env.docker.example，并设置 WEBUI_PASSWORD

# Optional: CNY per 1 USD for automatic models.dev prices; maintain this rate yourself.
# PRICING_USD_TO_CNY=
