# Copy to config/.env before running Docker Compose; fill the four required values.
OJ_USERNAME=
OJ_PASSWORD=
AI_API_KEY=
WEBUI_AUTH_TOKEN=

# Host port; bound to localhost only.
WEBUI_PORT=5000

# Web and daemon share one container. The daemon starts with the web service by
# default; set to 0 to start it manually from the Web UI.
# WEBUI_AUTOSTART_DAEMON=1
# Extra daemon arguments, e.g. only finished contests:
# WEBUI_DAEMON_ARGS=--ended-only

# Optional: fixed session signing key; otherwise a random key is generated at
# startup and users must log in again after each restart.
# WEBUI_SECRET_KEY=

# Optional: set to 1 when serving over HTTPS (Secure session cookie).
# WEBUI_COOKIE_SECURE=0

# Optional per-provider keys (only needed when referenced by models).
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=

# Optional override; omit to manage the start page in JSON / Web UI.
# OJ_CONTEST_START_PAGE=2

# Optional: CNY per 1 USD for automatic models.dev prices; maintain this rate yourself.
# PRICING_USD_TO_CNY=
